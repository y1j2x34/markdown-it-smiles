{
    "compilerOptions": {
        "rootDir": "./",
        "target": "ESNext",
        "module": "ESNext",
        "lib": [
            "ESNext",
            "DOM"
        ],
        "skipLibCheck": true,
        "esModuleInterop": true,
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "strict": true,
        "noImplicitAny": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedIndexedAccess": true,
        "paths": {
            "*": ["./*"],
            "markdown-it-smiles": ["./src/index.ts"],
            "markdown-it-smiles/*": ["./src/*"],
            "markdown-it-smiles-runtime": ["./dist/browser/esm/index.js"]
        }
    },
    "include": [
        "src",
        "tests",
        "dev",
        "examples/**/*.ts",
        "vitest.config.ts",
        "tsup.config.ts"
    ],
    "exclude": [
        "dist",
        "examples/dist"
    ]
}
